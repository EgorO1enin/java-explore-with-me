{
  "info": {
    "name": "Comments API Tests",
    "description": "Тесты для функциональности комментариев",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "eventId", 
      "value": "1"
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup - Create Test Data",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('userId', response.id);",
                  "    console.log('User ID set to:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Category created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('categoryId', response.id);",
                  "    console.log('Category ID set to:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Category\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories"]
            }
          }
        },
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('eventId', response.id);",
                  "    console.log('Event ID set to:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annotation\": \"Test event for comments\",\n  \"category\": {{categoryId}},\n  \"description\": \"Test event description for comments testing\",\n  \"eventDate\": \"2024-12-31 15:10:05\",\n  \"location\": {\n    \"lat\": 55.754167,\n    \"lon\": 37.62\n  },\n  \"paid\": false,\n  \"participantLimit\": 10,\n  \"requestModeration\": false,\n  \"title\": \"Test Event\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "events"]
            }
          }
        },
        {
          "name": "Publish Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event published successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stateAction\": \"PUBLISH_EVENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "events", "{{eventId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Public Comments API",
      "item": [
        {
          "name": "Get Comments by Event (Empty)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is empty', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.content).to.be.an('array');",
                  "    pm.expect(response.content).to.have.lengthOf(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/comments?from=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "comments"],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Private Comments API",
      "item": [
        {
          "name": "Create Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response).to.have.property('text');",
                  "    pm.expect(response).to.have.property('author');",
                  "    pm.expect(response).to.have.property('event');",
                  "    pm.expect(response).to.have.property('created');",
                  "    pm.expect(response).to.have.property('status');",
                  "    pm.expect(response.status).to.eql('PENDING');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('commentId', response.id);",
                  "    console.log('Comment ID set to:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Great event! Really enjoyed it.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/events/{{eventId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "events", "{{eventId}}", "comments"]
            }
          }
        },
        {
          "name": "Get User Comments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains user comments', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.content).to.be.an('array');",
                  "    pm.expect(response.content.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/comments?from=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "comments"],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Update Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment updated successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Comment text is updated', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.text).to.include('Updated comment');",
                  "    pm.expect(response).to.have.property('updated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Updated comment: This event was amazing!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "comments", "{{commentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Admin Comments API",
      "item": [
        {
          "name": "Get Comments for Moderation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains pending comments', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.content).to.be.an('array');",
                  "    pm.expect(response.content.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/comments?from=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "comments"],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Approve Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment approved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Comment status is APPROVED', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.status).to.eql('APPROVED');",
                  "    pm.expect(response).to.have.property('updated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "comments", "{{commentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Public Comments API (After Approval)",
      "item": [
        {
          "name": "Get Comments by Event (After Approval)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains approved comments', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.content).to.be.an('array');",
                  "    pm.expect(response.content.length).to.be.greaterThan(0);",
                  "    ",
                  "    response.content.forEach(comment => {",
                  "        pm.expect(comment.status).to.eql('APPROVED');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/comments?from=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "comments"],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Error Cases",
      "item": [
        {
          "name": "Create Comment - Empty Text",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
