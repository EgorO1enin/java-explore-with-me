    },
    {
      "name": "7. Cleanup",
      "item": [
        {
          "name": "Delete Comment by Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment deleted successfully', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "comments", "{{commentId}}"]
            }
          }
        }
