{
  "info": {
    "name": "Comments Feature Tests",
    "description": "Тесты функциональности комментариев к событиям",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "eventId", 
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup - Create Test Data",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('userId', response.id);",
                  "    console.log('User ID set to:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Comment Tester {{$randomInt}}\",\n  \"email\": \"comment{{$randomInt}}@test.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Category created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('categoryId', response.id);",
                  "    console.log('Category ID set to:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Comments Test Category {{$randomInt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories"]
            }
          }
        },
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('eventId', response.id);",
                  "    console.log('Event ID set to:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annotation\": \"Test event for comments functionality testing\",\n  \"category\": {{categoryId}},\n  \"description\": \"This is a test event created specifically for testing comments functionality. It includes all necessary fields to ensure proper comment creation and moderation.\",\n  \"eventDate\": \"2025-12-31 15:10:05\",\n  \"location\": {\n    \"lat\": 55.754167,\n    \"lon\": 37.62\n  },\n  \"paid\": false,\n  \"participantLimit\": 50,\n  \"requestModeration\": false,\n  \"title\": \"Comments Test Event {{$randomInt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "events"]
            }
          }
        },
        {
          "name": "Publish Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event published successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Event state is PUBLISHED', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.state).to.eql('PUBLISHED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stateAction\": \"PUBLISH_EVENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "events", "{{eventId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Comments - Basic Functionality",
      "item": [
        {
          "name": "Create Comment - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Comment has correct structure', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response).to.have.property('text');",
                  "    pm.expect(response).to.have.property('author');",
                  "    pm.expect(response).to.have.property('event');",
                  "    pm.expect(response).to.have.property('created');",
                  "    pm.expect(response).to.have.property('status');",
                  "});",
                  "",
                  "pm.test('Comment status is PENDING', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.status).to.eql('PENDING');",
                  "});",
                  "",
                  "pm.test('Comment text matches request', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.text).to.eql('This is a test comment for the event!');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('commentId', response.id);",
                  "    console.log('Comment ID set to:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"This is a test comment for the event!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/events/{{eventId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "events", "{{eventId}}", "comments"]
            }
          }
        },
        {
          "name": "Get User Comments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains user comments', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.content).to.be.an('array');",
                  "    pm.expect(response.content.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('Comment belongs to correct user', function () {",
                  "    const response = pm.response.json();",
                  "    const comment = response.content[0];",
                  "    pm.expect(comment.author.id).to.eql(parseInt(pm.collectionVariables.get('userId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/comments?from=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "comments"],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Update Comment - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment updated successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Comment text is updated', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.text).to.include('Updated comment');",
                  "});",
                  "",
                  "pm.test('Comment has updated timestamp', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('updated');",
                  "    pm.expect(response.updated).to.not.be.null;",
                  "});",
                  "",
                  "pm.test('Comment status remains PENDING', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.status).to.eql('PENDING');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Updated comment: This event was absolutely amazing! Highly recommend to everyone.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "comments", "{{commentId}}"]
            }
          }
        }
      ]
    },
